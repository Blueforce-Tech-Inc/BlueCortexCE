# =============================================================================
# Cortex CE Docker Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.docker .env
#
# NOTE: Variable names must match what docker-compose.yml expects.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_NAME=claude_mem
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# Spring AI OpenAI Configuration (DeepSeek or compatible)
# These variables are passed directly to docker-compose.yml as SPRING_* env vars.
# -----------------------------------------------------------------------------
SPRING_AI_OPENAI_API_KEY=sk-your-openai-key-here
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
SPRING_AI_OPENAI_CHAT_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# Embedding Model Configuration (SiliconFlow or compatible)
# -----------------------------------------------------------------------------
SPRING_AI_OPENAI_EMBEDDING_API_KEY=sk-your-embedding-key-here
SPRING_AI_OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn
SPRING_AI_OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
SPRING_AI_OPENAI_EMBEDDING_DIMENSIONS=1024

# -----------------------------------------------------------------------------
# Docker Image
# -----------------------------------------------------------------------------
# IMAGE_NAME=ghcr.io/blueforce-tech-inc/bluecortexce/cortex-ce:main  # default in docker-compose.yml

# -----------------------------------------------------------------------------
# Database Port (host port mapping)
# -----------------------------------------------------------------------------
# POSTGRES_PORT=5433  # default in docker-compose.yml; change if 5433 is in use

# -----------------------------------------------------------------------------
# Cortex CE Configuration
# -----------------------------------------------------------------------------
CLAUDE_MEM_MODE=code
SPRING_PROFILES_ACTIVE=prd

# -----------------------------------------------------------------------------
# Memory Refinement (Self-Evolution)
# -----------------------------------------------------------------------------
# Set to 'false' to disable automatic memory refinement/merging
# MEMORY_REFINE_ENABLED=true

# -----------------------------------------------------------------------------
# JVM Options
# -----------------------------------------------------------------------------
# JAVA_OPTS=-XX:+UseZGC -XX:MaxRAMPercentage=75.0

# -----------------------------------------------------------------------------
# Anthropic API (optional — set CLAUDEMEM_LLM_PROVIDER=anthropic to use)
# -----------------------------------------------------------------------------
# CLAUDEMEM_LLM_PROVIDER=anthropic
# SPRING_AI_ANTHROPIC_API_KEY=sk-ant-your-key-here
# SPRING_AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
# SPRING_AI_ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5
