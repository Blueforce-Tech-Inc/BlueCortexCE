<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.13</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>cortex-mem-demo</artifactId>
    <version>1.0.0</version>
    <name>Cortex Memory Demo</name>
    <description>Demo project showcasing cortex-mem-spring-integration from JitPack</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.1.2</spring-ai.version>
    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring AI (OpenAI-compatible) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Actuator (for /actuator/health including cortexMem) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Default: the local cortex-mem-starter built from THIS repository.

          It used to default to the jitpack profile below, but that profile pins a
          fixed upstream commit (6aa5de459c, 2026-03-18) which predates
          SessionStartRequest and CortexMemClient.updateSessionUserId. The demo
          source has moved on since, so a plain `mvn test` compiled against that
          stale artifact and failed with "cannot find symbol" errors in files the
          caller never touched. Building against the sibling modules in this repo
          removes that trap; a fresh clone must run the install step below once.

              cd cortex-mem-spring-integration && mvn install -DskipTests
              cd examples/cortex-mem-demo && mvn test
        -->
        <profile>
            <id>local</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <dependencies>
                <dependency>
                    <groupId>com.ablueforce.cortexce</groupId>
                    <artifactId>cortex-mem-starter</artifactId>
                    <version>1.0.0-SNAPSHOT</version>
                </dependency>
            </dependencies>
        </profile>
        <!--
          Opt-in: the published JitPack artifact. Use -Pjitpack to build against
          the pinned upstream commit instead of the local modules. Note the pin
          predates SessionStartRequest, so the demo does NOT compile against it;
          this profile exists for dependency-resolution experiments only.
        -->
        <profile>
            <id>jitpack</id>
            <dependencies>
                <dependency>
                    <groupId>com.github.Blueforce-Tech-Inc</groupId>
                    <artifactId>BlueCortexCE</artifactId>
                    <version>6aa5de459c</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
